{
  "openapi": "3.1.0",
  "info": {
    "title": "Gate agent API",
    "version": "1.0.0",
    "summary": "Check every action against a signed rulebook before it runs, and record what happened.",
    "description": "Agents that run their own tools call `POST /v1/check` before acting and `POST /v1/record` after. Actions that need a person return `decision: ask`; poll `GET /v1/approvals/{id}?wait=30` for the decision. MCP clients use `POST /mcp` instead, where Gate runs the tools itself. Every decision is written to a signed, hash-chained receipt.",
    "contact": {
      "email": "hello@elan1.ai"
    }
  },
  "servers": [
    {
      "url": "http://localhost:4000"
    }
  ],
  "security": [
    {
      "agentKey": []
    }
  ],
  "tags": [
    {
      "name": "Event API",
      "description": "For agents that run their own tools (the SDK)."
    },
    {
      "name": "MCP",
      "description": "Model Context Protocol over streamable HTTP. Gate runs the tools."
    },
    {
      "name": "Meta",
      "description": "This description."
    }
  ],
  "paths": {
    "/v1/check": {
      "post": {
        "operationId": "check",
        "tags": [
          "Event API"
        ],
        "summary": "Ask whether an action may run",
        "description": "Nothing is run. Writes a decision receipt. An `allow` returns a `check_id` to pass to `/v1/record`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Gate's decision.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckResponse"
                }
              }
            }
          },
          "400": {
            "description": "The body is not valid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid agent API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests for this key (300 a minute).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Gate failed. Nothing ran, and the action counts as refused.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/record": {
      "post": {
        "operationId": "record",
        "tags": [
          "Event API"
        ],
        "summary": "Report what happened after running an allowed or approved action",
        "description": "Give exactly one of `check_id` or `approval_id`. Writes an outcome receipt.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Recorded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordResponse"
                }
              }
            }
          },
          "400": {
            "description": "The body is not valid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid agent API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No allowed check or approved action with that id for this agent.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "An outcome was already recorded for this action.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests for this key (300 a minute).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Gate failed. Nothing ran, and the action counts as refused.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/approvals/{id}": {
      "get": {
        "operationId": "approvalStatus",
        "tags": [
          "Event API"
        ],
        "summary": "Get, or wait for, a decision on an action that needs a person",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The approval_id from a check.",
            "schema": {
              "type": "string",
              "maxLength": 64
            }
          },
          {
            "name": "wait",
            "in": "query",
            "required": false,
            "description": "Seconds to wait for a decision (long poll).",
            "schema": {
              "type": "number",
              "minimum": 0,
              "maximum": 30,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The approval's status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalStatus"
                }
              }
            }
          },
          "400": {
            "description": "The request is not valid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid agent API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No approval with that id for this agent.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests for this key (300 a minute).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Gate failed. Nothing ran, and the action counts as refused.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "operationId": "mcp",
        "tags": [
          "MCP"
        ],
        "summary": "MCP endpoint (JSON-RPC 2.0, stateless streamable HTTP)",
        "description": "Send MCP requests such as `initialize`, `tools/list` and `tools/call` with `accept: application/json, text/event-stream`. Each tool call is checked by Gate: it runs, waits for a person, or is refused. A refusal is a tool result with `isError: true` and `structuredContent.gate = { decision, rule_id, reason }`. An action that waits returns an `approval_id`; call `gate.approval_status` to wait for it. The tools and their input schemas are listed in `x-mcp-tools`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JsonRpcRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A JSON-RPC response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonRpcResponse"
                }
              }
            }
          },
          "202": {
            "description": "Accepted (a notification, no response body)."
          },
          "401": {
            "description": "Missing or invalid agent API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonRpcResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests for this key (300 a minute).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-mcp-tools": [
          {
            "name": "gmail.search",
            "description": "Search the mailbox for messages. Every call is checked by Gate: it may run, wait for a person, or be refused.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "query": {
                  "type": "string",
                  "maxLength": 500
                },
                "max_results": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 50
                }
              },
              "required": [
                "query"
              ],
              "additionalProperties": false
            }
          },
          {
            "name": "gmail.read_message",
            "description": "Read one message (sender, subject, body, attachment list). Every call is checked by Gate: it may run, wait for a person, or be refused.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "message_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "message_id"
              ],
              "additionalProperties": false
            }
          },
          {
            "name": "gmail.get_attachment",
            "description": "Download one attachment from a message. Every call is checked by Gate: it may run, wait for a person, or be refused.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "message_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "attachment_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "message_id",
                "attachment_id"
              ],
              "additionalProperties": false
            }
          },
          {
            "name": "gmail.draft_reply",
            "description": "Save a reply as a draft. Nothing is sent. Every call is checked by Gate: it may run, wait for a person, or be refused.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "message_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "body": {
                  "type": "string",
                  "maxLength": 20000
                }
              },
              "required": [
                "message_id",
                "body"
              ],
              "additionalProperties": false
            }
          },
          {
            "name": "gmail.send_reply",
            "description": "Send a reply on an existing thread. Every call is checked by Gate: it may run, wait for a person, or be refused.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "message_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "to": {
                  "type": "string",
                  "maxLength": 320,
                  "format": "email",
                  "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                },
                "body": {
                  "type": "string",
                  "maxLength": 20000
                }
              },
              "required": [
                "message_id",
                "to",
                "body"
              ],
              "additionalProperties": false
            }
          },
          {
            "name": "zoho.list_bills",
            "description": "List bills in Zoho Books. Every call is checked by Gate: it may run, wait for a person, or be refused.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "open",
                    "paid",
                    "overdue"
                  ]
                },
                "vendor_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "additionalProperties": false
            }
          },
          {
            "name": "zoho.get_vendor",
            "description": "Read a vendor's details. Every call is checked by Gate: it may run, wait for a person, or be refused.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "vendor_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "vendor_id"
              ],
              "additionalProperties": false
            }
          },
          {
            "name": "zoho.create_bill",
            "description": "Create a bill for a vendor invoice. Every call is checked by Gate: it may run, wait for a person, or be refused.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "vendor_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "bill_number": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "bill_date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "due_date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "amount_inr": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000000000
                },
                "description": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              "required": [
                "vendor_id",
                "bill_number",
                "bill_date",
                "amount_inr"
              ],
              "additionalProperties": false
            }
          },
          {
            "name": "zoho.record_bill_payment",
            "description": "Record a payment against a bill. Every call is checked by Gate: it may run, wait for a person, or be refused.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "bill_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "amount_inr": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000000000
                },
                "paid_on": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "reference": {
                  "type": "string",
                  "maxLength": 100
                }
              },
              "required": [
                "bill_id",
                "amount_inr"
              ],
              "additionalProperties": false
            }
          },
          {
            "name": "zoho.update_vendor",
            "description": "Change a vendor's details. Every call is checked by Gate: it may run, wait for a person, or be refused.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "vendor_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "fields": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "maxLength": 500
                    },
                    "email": {
                      "type": "string",
                      "maxLength": 500
                    },
                    "phone": {
                      "type": "string",
                      "maxLength": 500
                    },
                    "address": {
                      "type": "string",
                      "maxLength": 500
                    },
                    "gstin": {
                      "type": "string",
                      "maxLength": 500
                    },
                    "bank_account": {
                      "type": "string",
                      "maxLength": 500
                    },
                    "ifsc": {
                      "type": "string",
                      "maxLength": 500
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "vendor_id",
                "fields"
              ],
              "additionalProperties": false
            }
          },
          {
            "name": "gate.approval_status",
            "description": "Check on an action that is waiting for approval. Waits up to wait_seconds (max 30) for a decision. When approved, returns the action's result.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "approval_id": {
                  "type": "string"
                },
                "wait_seconds": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 30
                }
              },
              "required": [
                "approval_id"
              ],
              "additionalProperties": false
            }
          }
        ]
      }
    },
    "/v1/openapi.json": {
      "get": {
        "operationId": "openapi",
        "tags": [
          "Meta"
        ],
        "summary": "This OpenAPI description",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "agentKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "gk_…",
        "description": "The agent's API key from Agents → your agent → Keys and connection."
      }
    },
    "schemas": {
      "CheckRequest": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Tool name, e.g. zoho.record_bill_payment.",
            "examples": [
              "zoho.record_bill_payment"
            ]
          },
          "args": {
            "default": {},
            "description": "The tool's arguments. Validated against the tool's schema.",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "tool"
        ],
        "additionalProperties": false
      },
      "CheckResponse": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "decision": {
                "type": "string",
                "const": "allow"
              },
              "rule_id": {
                "type": "string",
                "description": "The rule that decided, or default."
              },
              "reason": {
                "type": "string"
              },
              "check_id": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Seq of the decision receipt. Pass it to /v1/record after running an allowed action."
              }
            },
            "required": [
              "decision",
              "rule_id",
              "reason",
              "check_id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "decision": {
                "type": "string",
                "const": "ask"
              },
              "rule_id": {
                "type": "string",
                "description": "The rule that decided, or default."
              },
              "reason": {
                "type": "string"
              },
              "check_id": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Seq of the decision receipt. Pass it to /v1/record after running an allowed action."
              },
              "approval_id": {
                "type": "string"
              },
              "approval_url": {
                "type": "string",
                "description": "Where a person decides."
              },
              "expires_at": {
                "type": "string",
                "description": "ISO 8601 time after which the action is refused."
              }
            },
            "required": [
              "decision",
              "rule_id",
              "reason",
              "check_id",
              "approval_id",
              "approval_url",
              "expires_at"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "decision": {
                "type": "string",
                "const": "refuse"
              },
              "rule_id": {
                "type": "string",
                "description": "The rule that decided, or default."
              },
              "reason": {
                "type": "string"
              },
              "check_id": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Seq of the decision receipt. Pass it to /v1/record after running an allowed action."
              }
            },
            "required": [
              "decision",
              "rule_id",
              "reason",
              "check_id"
            ],
            "additionalProperties": false
          }
        ]
      },
      "RecordRequest": {
        "type": "object",
        "properties": {
          "check_id": {
            "description": "The check_id of an allowed check. Give this or approval_id.",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "approval_id": {
            "description": "The id of an approved action the agent runs itself. Give this or check_id.",
            "type": "string",
            "maxLength": 64
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          },
          "ref": {
            "description": "Your reference for what happened, e.g. a payment id.",
            "type": "string",
            "maxLength": 200
          },
          "error": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "RecordResponse": {
        "type": "object",
        "properties": {
          "recorded": {
            "type": "boolean",
            "const": true
          },
          "receipt_seq": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "recorded",
          "receipt_seq"
        ],
        "additionalProperties": false
      },
      "ApprovalStatus": {
        "type": "object",
        "properties": {
          "approval_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected",
              "expired"
            ]
          },
          "expires_at": {
            "type": "string"
          },
          "rule_id": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "description": "What to do next, in plain words."
          },
          "outcome": {
            "description": "For actions Gate ran: how it went.",
            "type": "object",
            "properties": {
              "status": {
                "type": "string"
              },
              "ref": {
                "type": "string"
              },
              "error": {
                "type": "string"
              }
            },
            "required": [
              "status"
            ],
            "additionalProperties": false
          },
          "result": {
            "description": "For actions Gate ran: the tool's result."
          }
        },
        "required": [
          "approval_id",
          "status",
          "expires_at",
          "rule_id",
          "message"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "A plain-English message."
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "JsonRpcRequest": {
        "type": "object",
        "required": [
          "jsonrpc",
          "method"
        ],
        "properties": {
          "jsonrpc": {
            "const": "2.0"
          },
          "id": {
            "type": [
              "string",
              "integer",
              "null"
            ]
          },
          "method": {
            "type": "string",
            "examples": [
              "initialize",
              "tools/list",
              "tools/call"
            ]
          },
          "params": {
