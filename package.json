{
  "name": "gate",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r build",
    "demo": "pnpm --filter @gate/gate demo",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:migrate": "pnpm --filter @gate/db migrate",
    "db:seed": "pnpm --filter @gate/db seed",
    "gate": "pnpm --filter @gate/cli exec gate",
    "security:audit": "pnpm audit --audit-level high",
    "security:semgrep": "semgrep scan --config auto --error --severity ERROR --exclude-rule generic.secrets.security.detected-generic-secret.detected-generic-secret",
    "security:gitleaks": "gitleaks detect --no-banner --redact -v",
    "security:zap": "node scripts/zap-baseline.mjs",
    "security": "pnpm security:audit && pnpm security:semgrep && pnpm security:gitleaks"
  },
  "devDependencies": {
    "@eslint/js": "9",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "fast-check": "4.10.2",
    "globals": "^17.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7",
    "vitest": "3.2.7"
  }
}
