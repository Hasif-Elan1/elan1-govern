# Elan1 Govern configuration. Copy to .env:  cp .env.example .env
# The secrets below are DEV-ONLY sample values so a fresh clone runs as-is.
# Elan1 Govern refuses to start with them when APP_ENV=production. Generate real ones with:
#   pnpm run secrets   (or: openssl rand -hex 32)

# development | production. In production the sample secrets below are refused.
APP_ENV=development

DATABASE_URL=postgresql://gate:gate@localhost:5432/gate
TEST_DATABASE_URL=postgresql://gate:gate@localhost:5432/gate_test

# Encrypts org signing keys and OAuth tokens. Only the gate service reads it.
GATE_MASTER_KEY=d64ea57b8674c3341faa805776f88bfe811c3b634eca4d10f0618068c60023f8
# Authenticates web -> gate internal calls.
INTERNAL_API_SECRET=795318ad94ef33c64cff22c3d69daee64d9c3f233694547e0b6bd5a04717d3ba
# Signs approval links (gate creates them, web checks them).
APPROVAL_LINK_SECRET=38afb11ece8b54d65baf42af3b6b0e39463dc5c1239c67a8e9d51db8728c5bf2
# Encrypts TOTP secrets. Only the web app reads it.
WEB_ENC_KEY=c83135790e566f053a97603aca1497356c556b9a01bc2c09aa5d9132977f8817

WEB_URL=http://localhost:3000
GATE_PUBLIC_URL=http://localhost:4000
GATE_INTERNAL_URL=http://localhost:4000
GATE_PORT=4000

# Email (Mailpit in dev: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Elan1 Govern <govern@localhost>"

# mock = fake Gmail and Zoho Books with seeded data (no accounts needed). live = real APIs.
CONNECTOR_MODE=mock
# Upstream MCP servers on private, loopback or link-local addresses. Defaults to true unless APP_ENV=production.
# UPSTREAM_ALLOW_PRIVATE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_URL=https://www.zohoapis.in

# Demo org (seeded): sign in as owner@demo.test with this password.
DEMO_OWNER_PASSWORD=r5VCdQ8DED3e31sLGt7
DEMO_AGENT_KEY=gk_jIe0hpjdQRO5RF2bqvS6R0MhjIvvkAiyG5mKTzeMxmI
# The console's demo organisations (Demo Traders, Northbank, Kaveri Health, Deccan Cooperative Bank):
# every demo account (ananya.rao@demotraders.in …) signs in with this one password. Dev-only sample:
# refused when APP_ENV=production. Leave empty to skip seeding them.
DEMO_CONSOLE_PASSWORD=Kq7-demo-console-Wm4xT9
# The console's agents, keys, rulebooks, tools, approver groups and stop are applied to the guard after every
# console operation (on by default; off in tests unless set to on). off keeps the console on its own documents.
# CONSOLE_GUARD_SYNC=on

LOG_LEVEL=info

# Webhooks may call private, loopback and link-local addresses (true/false).
# Default: true unless APP_ENV=production. Keep it false in production (SSRF protection).
WEBHOOK_ALLOW_PRIVATE=
# Postgres schema for the pg-boss background job tables.
JOBS_SCHEMA=pgboss
# Approvals in Slack and WhatsApp. Leave as they are: production only accepts these hosts.
# Tests point them at local fake servers.
SLACK_API_URL=https://slack.com/api
WHATSAPP_API_URL=https://graph.facebook.com/v21.0

# Key custody: who wraps (or holds) new org signing keys. env (default) | aws-kms | soft-hsm.
# Rows keep the provider that wrapped them, so providers can be switched and keys re-wrapped later.
KEY_PROVIDER=env
# aws-kms only: a symmetric KMS key and its region. Credentials come from the standard AWS chain
# (environment, profile, instance or task role) and are never put here.
AWS_KMS_KEY_ID=
AWS_REGION=
# Timestamp authorities for L2+ Merkle batches (RFC 3161), at least two, comma-separated:
# local-a, local-b (in-process, works offline; the default), freetsa, digicert.
# One authority answering makes a batch "degraded"; none makes it "failed" (retried in the next batch).
TSA_AUTHORITIES=local-a,local-b
# The CA certificate(s) each hosted authority's tokens must chain to, PEM; required when it is listed.
# Write newlines as \n on one line, or quote a multi-line value. Download them from the authority yourself:
#   FreeTSA:  https://freetsa.org/files/cacert.pem
#   DigiCert: DigiCert Trusted Root G4 (https://cacerts.digicert.com/DigiCertTrustedRootG4.crt.pem)
TSA_FREETSA_CA_PEM=
TSA_DIGICERT_CA_PEM=
# Deployment profile. standard (default) or sovereign: deny-all egress except EGRESS_ALLOW
# (host, host:port, *.zone; internal names only) plus each organisation's own rules.
# In the sovereign profile SMTP_HOST must be on the list, and SLACK_API_URL / WHATSAPP_API_URL
# are off unless set to an internal relay on the list.
GATE_PROFILE=standard
EGRESS_ALLOW=
# Zones that count as inside the network besides .internal, .local, private addresses (e.g. corp.bank.co.in).
EGRESS_INTERNAL_DOMAINS=
EGRESS_LOG_RETENTION_DAYS=90
# Elan1 release keys that sign update bundles: base64 SPKI DER Ed25519 public keys, comma separated.
UPDATE_SIGNING_PUBLIC_KEYS=
