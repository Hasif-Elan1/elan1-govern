# Gate configuration. Copy to .env:  cp .env.example .env
# The secrets below are DEV-ONLY sample values so a fresh clone runs as-is.
# Gate refuses to start with them when APP_ENV=production. Generate real ones with:
#   pnpm run secrets   (or: openssl rand -hex 32)

# development | production. In production the sample secrets below are refused.
APP_ENV=development

DATABASE_URL=postgresql://gate:gate@localhost:5432/gate
TEST_DATABASE_URL=postgresql://gate:gate@localhost:5432/gate_test

# Encrypts org signing keys and OAuth tokens. Only the gate service reads it.
GATE_MASTER_KEY=d64ea57b8674c3341faa805776f88bfe811c3b634eca4d10f0618068c60023f8
# Authenticates web -> gate internal calls.
INTERNAL_API_SECRET=795318ad94ef33c64cff22c3d69daee64d9c3f233694547e0b6bd5a04717d3ba
# Signs approval links (gate creates them, web checks them).
APPROVAL_LINK_SECRET=38afb11ece8b54d65baf42af3b6b0e39463dc5c1239c67a8e9d51db8728c5bf2
# Encrypts TOTP secrets. Only the web app reads it.
WEB_ENC_KEY=c83135790e566f053a97603aca1497356c556b9a01bc2c09aa5d9132977f8817

WEB_URL=http://localhost:3000
GATE_PUBLIC_URL=http://localhost:4000
GATE_INTERNAL_URL=http://localhost:4000
GATE_PORT=4000

# Email (Mailpit in dev: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Gate <gate@localhost>"

# mock = fake Gmail and Zoho Books with seeded data (no accounts needed). live = real APIs.
CONNECTOR_MODE=mock
# Upstream MCP servers on private, loopback or link-local addresses. Defaults to true unless APP_ENV=production.
# UPSTREAM_ALLOW_PRIVATE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_URL=https://www.zohoapis.in

# Demo org (seeded): sign in as owner@demo.test with this password.
DEMO_OWNER_PASSWORD=r5VCdQ8DED3e31sLGt7
DEMO_AGENT_KEY=gk_jIe0hpjdQRO5RF2bqvS6R0MhjIvvkAiyG5mKTzeMxmI

LOG_LEVEL=info
