generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  admin
  approver
  viewer
  auditor
}

enum AgentStatus {
  active
  paused
}

enum RiskTier {
  low
  medium
  high
}

enum ApprovalStatus {
  pending
  approved
  rejected
  expired
}

// ---- Global (not tenant-scoped) ----

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  totpSecret   String? // AES-GCM encrypted
  totpEnabled  Boolean      @default(false)
  failedLogins Int          @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  sessions     Session[]
}

model Session {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrgId String?
  csrfToken   String
  lastAuthAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role      Role
  createdAt DateTime @default(now())

  @@unique([userId, orgId])
  @@index([orgId])
}

model Org {
  id            String       @id @default(cuid())
  name          String
  publicKey     String
  privateKeyEnc String // AES-GCM, key only in the gate service env
  notifyEmail   String?
  retentionDays Int          @default(2555)
  timezone      String       @default("Asia/Kolkata") // IANA zone; "day" quotas and Today reset at local midnight
  currency      String       @default("INR") // ISO 4217
  locale        String       @default("en-IN") // BCP 47, for number and date formatting
  industry      String? // industry pack id, e.g. "healthcare"; null = set up before packs (finance)
  regions       String[]     @default([]) // where the org operates: india | eu | us | uk | other
  createdAt     DateTime     @default(now())
  memberships   Membership[]
  agents        Agent[]
}

// ---- Tenant-scoped (every row has orgId; access only through forOrg()) ----

model Invite {
  id         String    @id @default(cuid())
  orgId      String
  email      String
  role       Role
  tokenHash  String    @unique
  invitedBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([orgId])
}

model Agent {
  id               String      @id @default(cuid())
  orgId            String
  org              Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  slug             String
  name             String
  purpose          String
  ownerEmail       String
  createdById      String?
  riskTier         RiskTier    @default(medium)
  riskAnswers      Json?
  status           AgentStatus @default(active)
  activeRulebookId String?
  lastActionAt     DateTime?
  createdAt        DateTime    @default(now())
  apiKeys          ApiKey[]
  rulebooks        Rulebook[]

  @@unique([orgId, slug])
}

model ApiKey {
  id         String    @id @default(cuid())
  orgId      String
  agentId    String
  agent      Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  label      String    @default("Default")
  prefix     String
  keyHash    String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([orgId])
}

model Rulebook {
  id         String   @id @default(cuid())
  orgId      String
  agentId    String
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  version    Int
  yaml       String
  hash       String
  signedBy   String
  createdAt  DateTime @default(now())

  @@unique([agentId, version])
  @@index([orgId])
}

model Connector {
  id           String    @id @default(cuid())
  orgId        String
  kind         String // gmail | zoho
  mode         String    @default("mock") // mock | live
  status       String    @default("connected") // connected | disconnected
  tokensEnc    String? // AES-GCM, key only in the gate service env
  accountLabel String?
  meta         Json?
  connectedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@unique([orgId, kind])
}

model Approval {
  id            String         @id @default(cuid())
  orgId         String
  agentId       String
  tool          String
  argsEnc       String? // full arguments, encrypted, wiped after the decision
  argsSummary   Json
  ruleId        String
  reason        String
  approverGroup String
  approvers     String[]
  evidence      Json?
  status        ApprovalStatus @default(pending)
  heldSeq       Int
  resolvedBy    String?
  note          String?
  selfApproval  Boolean        @default(false)
  executor      String         @default("gate") // gate (MCP: Elan1 Govern runs it) | agent (SDK: the agent runs it)
  result        Json?
  expiresAt     DateTime
  resolvedAt    DateTime?
  createdAt     DateTime       @default(now())
  links         ApprovalLink[]
  chatApproval  Boolean        @default(false) // the deciding rule allows approving in Slack or WhatsApp
  channel       String? // where it was decided: web | email | slack | whatsapp
  channelUser   String? // the chat user id (Slack team/user, or a hash of the WhatsApp number); never a phone number

  @@index([orgId, status])
}

model ApprovalLink {
  id         String    @id @default(cuid())
  orgId      String
  approvalId String
  approval   Approval  @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  email      String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([orgId])
}

model Receipt {
  id        String   @id @default(cuid())
  orgId     String
  seq       Int
  ts        DateTime
  kind      String
  agent     String?
  tool      String?
  decision  String?
  amountInr Float?
  outcome   String?
  action    String?
  body      Json
  hash      String
  createdAt DateTime @default(now())

  @@unique([orgId, seq])
  @@index([orgId, ts])
  @@index([orgId, agent])
}

model Checkpoint {
  id    String   @id @default(cuid())
  orgId String
  seq   Int
  hash  String
  ts    DateTime
  kid   String? // signing key id; absent on checkpoints from before key rotation
  sig   String

  @@index([orgId, seq])
}

// A framework the org has switched on (the library itself is code: @gate/core/frameworks).
model OrgFramework {
  id          String   @id @default(cuid())
  orgId       String
  frameworkId String
  enabledAt   DateTime @default(now())
  enabledBy   String

  @@unique([orgId, frameworkId])
}

model HealthAlert {
  id         String    @id @default(cuid())
  orgId      String?
  kind       String
  message    String
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

// Single sign-on (OIDC) for one organisation. The client secret is encrypted with WEB_ENC_KEY.
model SsoConnection {
  id              String    @id @default(cuid())
  orgId           String    @unique
  issuer          String
  clientId        String
  clientSecretEnc String
  domains         String[]
  verifyToken     String // put "gate-verify=<token>" in a DNS TXT record to prove each domain
  verifiedDomains String[]
  enforce         Boolean   @default(false) // verified domains must use SSO; password sign-in is refused
  defaultRole     Role      @default(viewer)
  enabled         Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ---- AI inventory and assessments ----
// Plain string columns: the accepted values are the lists in @gate/core (inventory.ts,
// assessments.ts), checked with zod at the API. Templates live in code, not in a table.

model AiSystem {
  id             String       @id @default(cuid())
  orgId          String
  name           String
  kind           String // agent | model | vendor_tool | internal_app
  vendor         String?
  purpose        String
  ownerEmail     String
  businessUnit   String?
  lifecycle      String       @default("proposed") // proposed | in_review | approved | live | retired
  riskTier       String       @default("unassessed") // low | medium | high | unassessed
  dataCategories String[]
  affectedPeople String[]
  decisionImpact String       @default("none") // none | supports_humans | makes_decisions
  agentId        String? // the Elan1 Govern agent this system is, when kind = agent
  nextReviewAt   DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  assessments    Assessment[]

  @@unique([orgId, agentId])
  @@index([orgId])
}

model Assessment {
  id              String    @id @default(cuid())
  orgId           String
  systemId        String
  system          AiSystem  @relation(fields: [systemId], references: [id], onDelete: Cascade)
  templateKey     String
  templateVersion Int
  answers         Json      @default("{}")
  score           Int?
  resultTier      String?
  status          String    @default("draft") // draft | submitted | approved | changes_requested
  createdBy       String // email
  submittedBy     String? // email
  submittedById   String? // user id, for separation of duties
  submittedAt     DateTime?
  reviewedBy      String? // email
  reviewedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([orgId, status])
  @@index([orgId, systemId])
}

// ---- Upstream MCP servers (tenant-scoped) ----

// An MCP server the org puts behind Elan1 Govern. Its tools reach agents only through the guard.
model UpstreamServer {
  id            String         @id @default(cuid())
  orgId         String
  slug          String // tool names are "<slug>.<tool>"
  name          String
  url           String
  authHeaderEnc String? // AES-GCM, key only in the gate service env
  status        String         @default("new") // new | ok | error
  lastSyncedAt  DateTime?
  error         String?
  createdAt     DateTime       @default(now())
  tools         UpstreamTool[]

  @@unique([orgId, slug])
}

model UpstreamTool {
  id          String         @id @default(cuid())
  orgId       String
  serverId    String
  server      UpstreamServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  name        String // namespaced: "<slug>.<tool>"
  description String         @default("")
  inputSchema Json
  tags        String[] // RiskTag values
  enabled     Boolean        @default(false) // new tools stay off until a person has checked their tags
  createdAt   DateTime       @default(now())

  @@unique([orgId, name])
  @@index([serverId])
}

// An org's Ed25519 signing keys. One is active (retiredAt null); retired keys stay for verification.
// Org.publicKey/privateKeyEnc hold the org's first key and are copied here by the migration.
model OrgKey {
  id            String    @id @default(cuid())
  orgId         String
  kid           String // key fingerprint: first 16 hex of sha256(public key PEM)
  publicKey     String
  privateKeyEnc String // wrapped by the gate's KeyProvider; only the gate service can unwrap it
  provider      String    @default("env") // which KeyProvider wrapped it
  createdAt     DateTime  @default(now())
  retiredAt     DateTime?

  @@unique([orgId, kid])
  @@index([orgId, retiredAt])
}

// Outbound webhooks (SIEM / log export, integrations).
model Webhook {
  id         String            @id @default(cuid())
  orgId      String
  url        String
  secretEnc  String // AES-GCM, key only in the gate service env
  events     String[]
  active     Boolean           @default(true)
  createdBy  String?
  createdAt  DateTime          @default(now())
  deliveries WebhookDelivery[]

  @@index([orgId])
}

model WebhookDelivery {
  id             String    @id @default(cuid())
  orgId          String
  webhookId      String
  webhook        Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event          String
  payload        Json
  status         String    @default("pending") // pending | delivered | failed
  attempts       Int       @default(0)
  lastError      String?
  responseStatus Int?
  nextAttemptAt  DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([orgId, webhookId, createdAt])
  @@index([status, nextAttemptAt])
}

// ---- Approvals in Slack and WhatsApp (a doorbell: rules, decisions and receipts stay in Elan1 Govern) ----

// One Slack app or WhatsApp business number per organisation.
model ChatChannel {
  id         String        @id @default(cuid())
  orgId      String
  kind       String // slack | whatsapp
  config     Json // not secret: Slack team and channel id; WhatsApp phone-number id and template names
  secretsEnc String // AES-GCM, key only in the gate service env: bot token + signing secret, or access token + app secret
  verifyHash String? // WhatsApp: sha256 of the webhook verify token (shown once)
  enabled    Boolean       @default(true)
  createdBy  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  messages   ChatMessage[]

  @@unique([orgId, kind])
}

// An approver's WhatsApp number in one organisation. Receipts and logs only ever see numberHash or last4.
model ChatNumber {
  id           String    @id @default(cuid())
  orgId        String
  userId       String
  numberEnc    String // E.164, AES-GCM, needed to send messages
  numberHash   String // HMAC of the number, to match incoming messages
  last4        String
  verifiedAt   DateTime?
  codeHash     String?
  codeExpires  DateTime?
  codeAttempts Int       @default(0)
  codesSent    Int       @default(0) // in the current window
  windowStart  DateTime?
  createdAt    DateTime  @default(now())

  @@unique([orgId, userId])
  @@unique([orgId, numberHash])
}

// One outgoing chat message (post, update) with its own retry state, like WebhookDelivery.
model ChatMessage {
  id              String      @id @default(cuid())
  orgId           String
  channelId       String
  channel         ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  approvalId      String
  kind            String // slack.post | slack.update | whatsapp.send
  recipientUserId String? // WhatsApp: the approver it goes to
  status          String      @default("pending") // pending | sent | failed
  attempts        Int         @default(0)
  lastError       String?
  externalId      String? // Slack message ts, or WhatsApp message id
  externalChannel String? // Slack channel id the message is in
  nextAttemptAt   DateTime?
  sentAt          DateTime?
  createdAt       DateTime    @default(now())

  @@index([orgId, approvalId])
  @@index([status, nextAttemptAt])
}
