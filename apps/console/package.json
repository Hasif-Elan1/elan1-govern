{
  "name": "@gate/console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Elan1 Govern — console, verifier and developer portal (front end)",
  "exports": {
    "./server": {
      "types": "./server.d.ts",
      "default": "./dist-server/domain.mjs"
    },
    "./ops.json": "./dist-server/ops.json"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_DATA=mock vite",
    "build": "tsc --noEmit && vite build && node scripts/build-server.mjs",
    "build:spa": "vite build",
    "build:mock": "VITE_DATA=mock vite build",
    "build:server": "node scripts/build-server.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/merge": "6.12.3",
    "@codemirror/view": "6.43.15",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/schibsted-grotesk": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@noble/ed25519": "2.3.0",
    "@noble/hashes": "1.8.0",
    "@tanstack/react-table": "8.21.3",
    "@uiw/react-codemirror": "4.25.12",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "recharts": "2.15.4",
    "yaml": "2.9.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.6.1",
    "esbuild": "0.28.2",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.19",
    "typescript": "5.6.3",
    "vite": "7.3.7"
  }
}
